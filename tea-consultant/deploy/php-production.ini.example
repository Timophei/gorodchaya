; Рекомендуемые продовые настройки PHP для «Чайного города».
; Это НЕ полный php.ini, а именно те директивы, которые стоит проверить/выставить.
; Найти активный php.ini на сервере: php --ini
; Обычно правится файл вида /etc/php/8.3/fpm/conf.d/99-tea-consultant.ini (php-fpm, версия —
; актуальная для Ubuntu 24.04; на других системах подставьте свою — узнать: php -v)
; или /etc/php/8.3/apache2/conf.d/99-tea-consultant.ini (mod_php) — создайте отдельным файлом,
; чтобы не трогать системный php.ini напрямую, затем перезапустите php-fpm/apache2.

; Ошибки НЕ должны попадать в тело ответа — приложение само отправляет JSON,
; и любой посторонний вывод его сломает (мы уже ловили этот баг на dev-окружении).
display_errors = Off
display_startup_errors = Off

; Но логировать ошибки нужно обязательно — иначе будет нечем дебажить.
log_errors = On
error_log = /var/log/php-tea-consultant-error.log
error_reporting = E_ALL

; Разумные лимиты для чат-эндпоинта
max_execution_time = 45
memory_limit = 128M
post_max_size = 2M
upload_max_filesize = 2M

; Часовой пояс — влияет на временные метки в логах приложения (logs/requests.log,
; error_log). Это НЕ зависит от физического расположения сервера (сервер может стоять
; хоть во Франции) — ставьте часовой пояс, удобный вам для чтения логов, например
; часовой пояс вашей команды/бизнеса.
date.timezone = Europe/Moscow

; expose_php лучше выключить (не относится к безопасности данных, но не светит версию PHP в заголовках)
expose_php = Off
