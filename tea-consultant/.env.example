# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в Git (см. .gitignore).

# Ключ сервисного аккаунта проекта TeaGorod. Никогда не передаётся во фронтенд.
OPENAI_API_KEY=sk-proj-...

# Модель для обращений к Responses API. Можно переключать без изменения кода.
OPENAI_MODEL=gpt-5.6-terra

# Необязательно: ID проекта OpenAI, если используется несколько проектов на аккаунте.
OPENAI_PROJECT_ID=

# Таймаут обращения к OpenAI, секунды.
OPENAI_TIMEOUT_SECONDS=30

# Максимальная длина сообщения пользователя, символы.
MAX_MESSAGE_LENGTH=1000

# Сколько последних сообщений диалога передавать модели как историю.
HISTORY_MESSAGE_LIMIT=15

# Ограничение частоты запросов: не более N запросов за окно (секунды) с одного IP.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=300
